{
  "modmap": [
    {
      "name": "Command uses Control by default",
      "remap": {
        "Alt_L": {
          "skip_key_event": true,
          "press": [
            {
              "press": "Ctrl_R"
            },
            {
              "set_mode": "command"
            }
          ],
          "release": [
            {
              "release": "Ctrl_R"
            },
            {
              "release": "Super_L"
            },
            {
              "set_mode": "default"
            }
          ]
        },
        "Super_L": "Alt_L"
      }
    }
  ]
}
