{
  "modmap": [
    {
      "name": "Physical Control stays Control in standalone terminals",
      "application": {
        "only": [
          "/(?i)^(gnome-terminal-server|org\\.gnome\\.Terminal|kgx|org\\.gnome\\.Console|ptyxis|org\\.gnome\\.Ptyxis|alacritty|kitty|org\\.wezfurlong\\.wezterm|konsole|xterm)$/"
        ]
      },
      "remap": {
        "Ctrl_L": "Ctrl_L",
        "Ctrl_R": "Ctrl_L"
      }
    },
    {
      "name": "Physical Control becomes Super in other applications",
      "application": {
        "only": "/.+/"
      },
      "remap": {
        "Ctrl_L": "Super_R",
        "Ctrl_R": "Super_R"
      }
    },
    {
      "name": "Preserve physical Control when desktop context is unavailable",
      "remap": {
        "Ctrl_L": "Ctrl_L",
        "Ctrl_R": "Ctrl_L"
      }
    }
  ],
  "keymap": [
    {
      "name": "Emergency stop with Command held",
      "mode": [
        "command",
        "switcher"
      ],
      "remap": {
        "Ctrl-Esc": {
          "action": "exit"
        },
        "Super_R-Esc": {
          "action": "exit"
        }
      }
    },
    {
      "name": "Emergency stop with Option held",
      "remap": {
        "Ctrl-Alt_L-Esc": {
          "action": "exit"
        },
        "Super_R-Alt_L-Esc": {
          "action": "exit"
        }
      }
    },
    {
      "name": "Control Command Q locks the screen",
      "mode": "command",
      "exact_match": true,
      "remap": {
        "Ctrl-q": {
          "launch": [
            "ubuntu-command-lock"
          ]
        },
        "Super_R-q": {
          "launch": [
            "ubuntu-command-lock"
          ]
        }
      }
    },
    {
      "name": "Command H minimizes the focused window",
      "mode": "command",
      "exact_match": true,
      "remap": {
        "h": [
          {
            "release": "Ctrl_R"
          },
          "Super_L-h",
          {
            "press": "Ctrl_R"
          }
        ]
      }
    },
    {
      "name": "Hold the native app switcher until Command is released",
      "mode": "command",
      "remap": {
        "Tab": [
          {
            "release": "Ctrl_R"
          },
          {
            "press": "Super_L"
          },
          {
            "press": "Tab"
          },
          {
            "release": "Tab"
          },
          {
            "set_mode": "switcher"
          }
        ]
      }
    },
    {
      "name": "Cycle the native app switcher",
      "mode": "switcher",
      "remap": {
        "Tab": [
          {
            "press": "Tab"
          },
          {
            "release": "Tab"
          }
        ]
      }
    },
    {
      "name": "Terminal copy and close",
      "application": {
        "only": [
          "/(?i)^(gnome-terminal-server|org\\.gnome\\.Terminal|kgx|org\\.gnome\\.Console|ptyxis|org\\.gnome\\.Ptyxis|alacritty|kitty|org\\.wezfurlong\\.wezterm|konsole|xterm)$/"
        ]
      },
      "remap": {
        "c": "Shift-c",
        "v": "Shift-v",
        "w": "Shift-w",
        "Shift-w": "Shift-q",
        "t": "Shift-t",
        "n": "Shift-n"
      },
      "mode": "command"
    },
    {
      "name": "Command quit when desktop context is available",
      "mode": "command",
      "application": {
        "only": "/.+/"
      },
      "remap": {
        "q": {
          "launch": [
            "ubuntu-command-quit"
          ]
        }
      }
    }
  ]
}
