#!/usr/bin/env bash
# Agent browsers: one private Chromium per agent, each on its own invisible
# screen, so agents never share tabs and nothing pops up on the desktop.
#
#   agent-browser start [--size 1920x1080] [--visible] [-- CHROMIUM_ARGS...]
#   agent-browser stop ID | --all
#   agent-browser status ID
#   agent-browser list [--json]
#
# start prints the new browser's ID (a UUID) and debug port.
# Each browser gets a fresh profile, deleted on stop. The screen can be watched
# over VNC through a private Unix socket (no network port); cPanel shows it.
# --visible opens a normal window on the desktop instead (no VNC).
# Browsers older than AGENT_BROWSER_MAX_AGE_HOURS (default 12) are stopped
# automatically, as are leftovers of crashed browsers.
set -euo pipefail

DATA_ROOT="${AGENT_BROWSER_HOME:-$HOME/snap/chromium/common/agent-browser}"
RUN_ROOT="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/agent-browser"
MAX_AGE_HOURS="${AGENT_BROWSER_MAX_AGE_HOURS:-12}"
SELF="$(readlink -f "${BASH_SOURCE[0]}")"

die() { echo "$*" >&2; exit 1; }
usage() { sed -n '2,16s/^# \{0,1\}//p' "$SELF"; }

instance_dir() { echo "$DATA_ROOT/$1"; }
socket_path() { echo "$RUN_ROOT/$1.sock"; }
read_field() {
  local file
  file="$(instance_dir "$1")/instance.env"
  [ -f "$file" ] || return 0
  sed -n "s/^$2=//p" "$file" | head -n1
}

# IDs are lowercase UUIDs; this also keeps them safe in paths.
valid_id() { [[ "$1" =~ ^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$ ]]; }

# The supervisor leads its own process group; the browser is alive while it is.
alive() {
  local pgid
  pgid="$(read_field "$1" pgid)"
  [ -n "$pgid" ] && kill -0 "$pgid" 2>/dev/null \
    && [ "$(ps -o pgid= -p "$pgid" 2>/dev/null | tr -d ' ')" = "$pgid" ]
}

port_up() { curl -s --max-time 1 "http://127.0.0.1:$1/json/version" >/dev/null; }

# Stops the process group (if any) and removes all files of an instance.
destroy() {
  local id="$1" pgid
  pgid="$(read_field "$id" pgid)"
  if [ -n "$pgid" ] && pgrep -g "$pgid" >/dev/null 2>&1; then
    kill -TERM -- "-$pgid" 2>/dev/null || true
    for _ in $(seq 1 40); do
      pgrep -g "$pgid" >/dev/null 2>&1 || break
      sleep 0.25
    done
    kill -KILL -- "-$pgid" 2>/dev/null || true
  fi
  rm -rf -- "$(instance_dir "$id")" "$(socket_path "$id")"
}

ids() {
  [ -d "$DATA_ROOT" ] || return 0
  local d
  for d in "$DATA_ROOT"/*/; do
    [ -d "$d" ] && basename "$d"
  done
  return 0
}

# Removes leftovers of dead browsers and stops ones past the age limit.
gc() {
  local id started now
  now="$(date +%s)"
  for id in $(ids); do
    if ! alive "$id"; then
      # Give a browser that is still starting a minute before treating it as dead.
      started="$(read_field "$id" started)"
      if [ -z "$started" ] || [ $((now - started)) -gt 60 ]; then destroy "$id"; fi
      continue
    fi
    started="$(read_field "$id" started)"
    if [ -n "$started" ] && [ $((now - started)) -gt $((MAX_AGE_HOURS * 3600)) ]; then
      destroy "$id"
    fi
  done
}

# Runs in its own process group: the screen, then Chromium in the foreground.
# Everything in the group is stopped together.
run() {
  local id="$1" size="$2" visible="$3"; shift 3
  local dir display="" xpid=""
  dir="$(instance_dir "$id")"
  RUN_SOCKET="$(socket_path "$id")"
  local sock="$RUN_SOCKET"

  # However this ends (stop, crash, Chromium closed), take the whole group down.
  trap 'rm -f -- "$RUN_SOCKET"; trap - TERM; kill -TERM 0 2>/dev/null' EXIT
  trap 'exit 0' TERM INT

  if [ "$visible" = 0 ]; then
    Xvnc -displayfd 3 -geometry "$size" -depth 24 \
      -SecurityTypes None -rfbport -1 -rfbunixpath "$sock" -rfbunixmode 0600 \
      -nolisten tcp -AlwaysShared -AcceptSetDesktopSize=0 \
      3>"$dir/display" >"$dir/screen.log" 2>&1 </dev/null &
    xpid=$!
    for _ in $(seq 1 40); do
      display="$(tr -dc '0-9' <"$dir/display" 2>/dev/null || true)"
      [ -n "$display" ] && [ -S "$sock" ] && break
      kill -0 "$xpid" 2>/dev/null || exit 1
      sleep 0.25
    done
    [ -n "$display" ] || exit 1
    echo "display=$display" >>"$dir/instance.env"
    echo "socket=$sock" >>"$dir/instance.env"
    unset WAYLAND_DISPLAY
    export DISPLAY=":$display"
    set -- --ozone-platform=x11 "$@"
  fi

  chromium \
    --user-data-dir="$dir/profile" \
    --remote-debugging-port=0 \
    --no-first-run --no-default-browser-check \
    --password-store=basic \
    --window-size="${size/x/,}" --window-position=0,0 \
    "$@" >"$dir/browser.log" 2>&1 </dev/null &
  wait $!
}

start() {
  local id size=1920x1080 visible=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --size) size="${2:?--size needs WIDTHxHEIGHT}"; shift 2 ;;
      --size=*) size="${1#--size=}"; shift ;;
      --visible) visible=1; shift ;;
      --) shift; break ;;
      *) die "Unknown option: $1 (use -- before Chromium arguments)" ;;
    esac
  done
  [[ "$size" =~ ^[0-9]+x[0-9]+$ ]] || die "--size must look like 1920x1080"
  id="$(cat /proc/sys/kernel/random/uuid)"
  [ "$visible" = 1 ] || command -v Xvnc >/dev/null \
    || die "Xvnc is missing. Install it with: sudo apt-get install tigervnc-standalone-server"

  gc

  local dir
  dir="$(instance_dir "$id")"
  mkdir -p "$dir/profile"
  mkdir -p "$RUN_ROOT"
  chmod 700 "$RUN_ROOT"
  {
    echo "id=$id"
    echo "size=$size"
    echo "visible=$visible"
    echo "started=$(date +%s)"
  } >"$dir/instance.env"

  setsid "$SELF" _run "$id" "$size" "$visible" "$@" </dev/null >/dev/null 2>&1 &
  echo "pgid=$!" >>"$dir/instance.env"

  local port=""
  for _ in $(seq 1 60); do
    port="$(head -n1 "$dir/profile/DevToolsActivePort" 2>/dev/null || true)"
    if [ -n "$port" ] && port_up "$port"; then
      echo "port=$port" >>"$dir/instance.env"
      echo "Browser $id running, debug port is $port"
      echo "Stop it when done: agent-browser stop $id"
      return 0
    fi
    alive "$id" || break
    sleep 0.25
  done
  local logs
  logs="$(tail -n 5 "$dir/screen.log" "$dir/browser.log" 2>/dev/null || true)"
  destroy "$id"
  die "Browser $id didn't start within 15s. Last log lines:
$logs"
}

stop() {
  [ $# -eq 1 ] || die "Usage: agent-browser stop ID | --all"
  local id
  if [ "$1" = --all ]; then
    for id in $(ids); do destroy "$id"; echo "Browser $id stopped"; done
    return 0
  fi
  valid_id "$1" || die "Invalid browser ID: $1"
  if [ ! -d "$(instance_dir "$1")" ]; then echo "Browser $1 not running"; return 0; fi
  destroy "$1"
  echo "Browser $1 stopped"
}

status() {
  if [ $# -ne 1 ] || ! valid_id "$1"; then die "Usage: agent-browser status ID"; fi
  if ! alive "$1"; then echo "Browser $1 not running"; return 1; fi
  local port
  port="$(read_field "$1" port)"
  if [ -n "$port" ] && port_up "$port"; then
    echo "Browser $1 running, debug port is $port"
  else
    echo "Browser $1 running, but its debug port isn't responding"
    return 1
  fi
}

# Memory of a browser's whole process group in MB. PSS splits shared pages
# between processes, so the sum isn't inflated like RSS would be.
memory_mb() {
  local pgid pid kb=0 pss
  pgid="$(read_field "$1" pgid)"
  [ -n "$pgid" ] || { echo 0; return 0; }
  for pid in $(pgrep -g "$pgid" 2>/dev/null || true); do
    pss="$(awk '/^Pss:/ {print $2}' "/proc/$pid/smaps_rollup" 2>/dev/null || true)"
    kb=$((kb + ${pss:-0}))
  done
  echo $((kb / 1024))
}

json_str() { printf '"%s"' "$(printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g')"; }

list() {
  local json=0 id first=1
  [ "${1:-}" = --json ] && json=1
  gc
  [ "$json" = 1 ] && printf '['
  for id in $(ids); do
    alive "$id" || continue
    local port size visible started socket memory
    port="$(read_field "$id" port)"
    size="$(read_field "$id" size)"
    visible="$(read_field "$id" visible)"
    started="$(read_field "$id" started)"
    socket="$(read_field "$id" socket)"
    memory="$(memory_mb "$id")"
    if [ "$json" = 1 ]; then
      [ "$first" = 1 ] || printf ','
      first=0
      printf '{"id":%s,"debugPort":%s,"size":%s,"visible":%s,"startedAt":%s,"vncSocket":%s,"memoryMb":%s}' \
        "$(json_str "$id")" "${port:-null}" "$(json_str "$size")" \
        "$([ "$visible" = 1 ] && echo true || echo false)" "${started:-null}" \
        "$([ -n "$socket" ] && json_str "$socket" || echo null)" "$memory"
    else
      printf '%s\tport %s\tstarted %s\t%s MB\n' "$id" "${port:-?}" \
        "$(date -d "@$started" '+%H:%M' 2>/dev/null || echo '?')" "$memory"
    fi
  done
  [ "$json" = 1 ] && printf ']\n'
  return 0
}

cmd="${1:-}"
[ $# -gt 0 ] && shift
case "$cmd" in
  start) start "$@" ;;
  stop) stop "$@" ;;
  status) status "$@" ;;
  list) list "$@" ;;
  _run) run "$@" ;;
  -h|--help|help|"") usage ;;
  *) die "Unknown command: $cmd (see agent-browser --help)" ;;
esac
