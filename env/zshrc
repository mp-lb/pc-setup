source "$PC_SETUP_REPO_PATH/lib/runtime-path.sh"
typeset -U path
path=("$PC_SETUP_REPO_PATH/bin" "${path[@]}")

export ZSH="$HOME/.oh-my-zsh"
if [[ -f "$ZSH/oh-my-zsh.sh" ]]; then
  if (( ! $+functions[omz] )); then
    plugins=(git docker docker-compose)
    [[ "$OSTYPE" == darwin* ]] && plugins+=(brew)
    source "$ZSH/oh-my-zsh.sh"
  fi
  source "$PC_SETUP_REPO_PATH/env/zsh-theme.sh"
fi
if command -v mise >/dev/null 2>&1; then
  eval "$(mise activate zsh)"
fi
alias gpop="git reset HEAD^"
alias gtsync="git fetch --tags && git push origin --tags"
alias yolo="claude --dangerously-skip-permissions"
if [[ -f "$PC_SETUP_REPO_PATH/zshrc-user.sh" ]]; then
  source "$PC_SETUP_REPO_PATH/zshrc-user.sh"
fi
